# ===== Copie este arquivo para ".env" (uso local) ou cadastre cada linha em Render > Environment =====

# --- Banco de dados (AlwaysData) ---
DB_HOST=mysql-SUACONTA.alwaysdata.net
DB_PORT=3306
DB_USER=SUACONTA_usuario
DB_PASSWORD=troque-esta-senha
DB_NAME=SUACONTA_educonnect
DB_POOL=5

# --- Segurança ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-texto-aleatorio-com-mais-de-32-caracteres
JWT_EXPIRA=8h

# --- CORS: SOMENTE o domínio (sem caminho e sem barra no final) ---
# Ex.: https://seuusuario.github.io  (vários: separe por vírgula)
CORS_ORIGINS=https://SEUUSUARIO.github.io
# Endereço base do site (usado no link do e-mail de recuperação; inclua o nome do repositório)
FRONTEND_URL=https://SEUUSUARIO.github.io/NOME-DO-REPOSITORIO

# --- E-mail (opcional; API HTTPS da Brevo, pois o Render gratuito bloqueia SMTP) ---
BREVO_API_KEY=
EMAIL_REMETENTE=
EMAIL_NOME=EduConnect

# --- Execução ---
NODE_ENV=production
