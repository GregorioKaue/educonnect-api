# Copie para .env (local) ou cadastre estas variáveis no painel do Render. NUNCA envie o .env ao GitHub.
PORT=3000
NODE_ENV=production

# Banco (AlwaysData: painel > Bancos de dados > MySQL)
DB_HOST=mysql-SEUUSUARIO.alwaysdata.net
DB_PORT=3306
DB_USER=SEUUSUARIO
DB_PASSWORD=
DB_NAME=SEUUSUARIO_educonnect

# Segredo do JWT (mínimo 32 caracteres): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origens do frontend liberadas no CORS (separe por vírgula, sem barra e sem caminho)
CORS_ORIGINS=https://SEUUSUARIO.github.io
# Endereço base do site (usado no link do e-mail de recuperação; /pages/redefinir-senha.html é acrescentado)
FRONTEND_URL=https://SEUUSUARIO.github.io/NOME-DO-REPOSITORIO

# E-mail (recuperação de senha). Sem SMTP_HOST, o link aparece só no log (apenas fora de produção).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduConnect <nao-responda@suaescola.com.br>"
